{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2024/08/02/cross-origin/",
      "destination": "/2024/08/03/cross-origin/",
      "permanent": true
    },
    {
      "source": "/2024/08/27/session-cookie/",
      "destination": "/2024/08/28/session-cookie/",
      "permanent": true
    },
    {
      "source": "/2024/09/04/nginx-upstream-check-module-using/",
      "destination": "/2024/09/05/nginx-upstream-check-module-using/",
      "permanent": true
    },
    {
      "source": "/2024/10/17/2023-2024/",
      "destination": "/2024/10/18/2023-2024/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|rss2\\.xml|local-search\\.xml|xml/local-search\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff|woff2|ttf|otf|eot|map)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
